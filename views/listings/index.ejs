<% layout("/layouts/boilerplate") %>
<style>
  .filters{
    display: flex;
    text-align: center;
    margin: 1rem 0;
  }
  .filter{
    margin: 0 1rem;
    opacity: 0.7;
    font-size: 1rem;
  }
  .filter p{
    font-size: 0.8rem;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  /* .filter-container{
    display: flex;
  }

  .tax-switch{
    border: 1px solid black;
    border-radius: 15px;
    height: 1.5rem;
  } */
</style>
<body>
<div class="filter-container">
 <div class="filters">
  <div class="filter">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-mountain-city"></i>
    <p>Iconnic Cities</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Amazing Pools</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-ferry"></i>
    <p>Boats</p>
  </div>
 </div>

 <!-- <div class="form-check-reverse form-switch tax-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display Total after taxes</label>
</div> -->
</div> 
  <!-- <form action="/listings/new" method="get">
    <button>Create new</button>
  </form> -->
  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 row-cols-1">
    <% for (let listing of allListings){ %>
    <div class="card col listing-card">
        <a href="/listings/<%=listing._id%>/show"><img src="<%=listing.image.url%>" class="card-img-top" alt="<%= listing.title%>" style="height: 20rem">
          <div class="card-img-overlay"></div>
       </a>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title%></b><br>
            &#8377;<%=listing.price.toLocaleString("en-IN")%>/night

          </p>
        </div>
      </div>
    <% } %>
</div>

    <!-- <ul>
        <% for (let listing of allListings){ %>
            <li><a href="/listings/<%=listing._id%>/show"><%= listing.title%></a></li>
       <% } %>
    </ul> -->
    
</body>
 