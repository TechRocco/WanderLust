<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row col-10 col-lg-8 offset-1 offset-lg-2 mt-3">
            <h3>
                <%=list.title%>
            </h3>

            <div class="card listing-card" style="width: 50rem;">
                <img src="<%=list.image.url%>" class="card-img-top show-img" alt="..." style="height: 20rem;">
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            Owned By <i>
                                <%=list.owner.username%>
                            </i>
                        </b> <br>
                        <%=list.description%> <br>
                            &#8377;<%=list.price.toLocaleString("en-IN")%>/night <br>
                                <i class="fa-solid fa-location-dot"></i>
                                <%=list.location%> <br>
                                    <i class="fa-solid fa-globe"></i>
                                    <%=list.country%>
                    </p>
                </div>
            </div>
        </div>

        <% if(currUser && currUser._id.equals(list.owner._id)){ %>
            <div class="row mb-3 col-10 col-lg-8 offset-1 offset-lg-2">
                <a href="/listings/<%=list._id%>/edit" class="btn btn-dark col-sm-2 col-lg-1 col-2 editBtn">Edit</a>
                <!-- <form action="/listings/<%=list._id%>/edit" method="get" class="col-md-1 ">
        <input type="button" value="Edit" class="btn btn-dark editBtn"> 
    </form><br><br> -->

                <form action="/listings/<%=list._id%>?_method=DELETE" method="post" class="col-1 deleteForm">
                    <input type="button" value="Delete" class="delete btn btn-dark">
                </form>
            </div>
            <% } %>


                <!-- reviews -->
                <div class="row col-10 col-lg-8 offset-1 offset-lg-2">
                    <hr class="col-11">
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%=list._id%>/review" method="post" novalidate class="needs-validation">
                        <div class="col-11 mb-3 mt-2">
                            <!-- <label for="rating" class="form-label">Rating</label> -->
                            <fieldset class="starability-slot">
                                <legend>Rating:</legend>
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="col-11 mb-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="2" class="form-control"
                                required></textarea>
                            <div class="invalid-feedback">Please add some comments for review.</div>
                        </div>
                        <button class="btn btn-outline-dark mb-3">Submit</button>

                    </form>
                </div>
                <!-- show Reviews -->
                <div class="row col-10 col-lg-8 offset-1 offset-lg-2">
                    <hr class="col-11">

                    <h4>All Reviews</h4>

                    <%if(list.reviews.length==0){%>
                        <p><b>No Reviews Yet</b></p>
                        <%}%>

                            <% for(let review of list.reviews){ %>
                                <div class="card col-sm-10 col-md-4 col-lg-5 m-2">
                                    <div class="card-body">
                                        <h5 class="card-title d-flex justify-content-between">
                                            <div>
                                                @<%= review.author.username%>
                                            </div>
                                            <% if(currUser && currUser._id.equals(review.author._id)){ %>
                                                <div>
                                                    <form
                                                        action="/listings/<%=list._id%>/review/<%=review._id%>?_method=DELETE"
                                                        method="post">
                                                        <button class="border-0 btn mt-0 mb-0"><i
                                                                class="fa-solid fa-xmark "></i></button>
                                                    </form>
                                                </div>
                                                <% } %>
                                        </h5>
                                        <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
                                        <p class="card-text mb-1">
                                            <%=review.comment%>
                                        </p>
                                    </div>
                                </div>
                                <% } %>

                </div>

                <!-- MAP -->

                <div class="row col-10 col-lg-8 offset-1 offset-lg-2 mb-2">
                    <hr class="col-11">
                    <h4>Where you'll be</h4>
                    <div id="map"></div>
                </div>




                <script>

                    // TO MAKE THE MAP APPEAR YOU MUST
                    // ADD YOUR ACCESS TOKEN FROM

                    let mapToken = "<%= process.env.MAP_TOKEN %>"
                    console.log(mapToken)
                    mapboxgl.accessToken = mapToken;
                    const map = new mapboxgl.Map({
                        container: 'map', // container ID
                        center: <%- JSON.stringify(list.geometry.coordinates) %>, // starting position [lng, lat]
                        zoom: 9 // starting zoom
                    });

                    const marker = new mapboxgl.Marker({ color: "red" })
                        .setLngLat( <%- JSON.stringify(list.geometry.coordinates) %>)
                        .setPopup(new mapboxgl.Popup({ offset: 25, closeButton:false}).setHTML(
                            "<p>Exact location provided after booking</p>"))
                        .addTo(map);

   


                    let btn = document.querySelector(".delete");
                    let form = document.querySelector(".deleteForm");
                    btn.addEventListener("click", () => {
                        let response = confirm("Are you sure want to delete?");
                        if (response) {
                            form.submit();
                        }
                    });
                </script>

    </body>


    <!-- <ul>
        <li><%=list.title%></li>
        <li><%=list.description%></li>
        <li><img src="<%=list.image.url%>" alt="" width="500vw" height="500vh"></li>
        <li>&#8377;<%=list.price.toLocaleString("en-IN")%></li>
        <li><%=list.location%></li>
        <li><%=list.country%></li>
    </ul> -->